-- By lsp already, and I don't need it fix implicitly
-- Prettier also work with yaml already
---@type LazySpec
return {
  "stevearc/conform.nvim",
  ---@module 'conform'
  ---@type conform.setupOpts
  opts = {
    formatters_by_ft = {
      ansible = {
        "prettier",
        -- "ansible-lint", -- by lsp already
      },
    },
  },
  optional = true,
}
